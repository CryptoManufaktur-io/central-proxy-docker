# Copy this to .env and adjust
COMPOSE_FILE=traefik-aws.yml:prometheus.yml:promtail.yml

# Secure web proxy
DOMAIN=example.com
ACME_EMAIL=user@example.com
CF_DNS_API_TOKEN=SECRETTOKEN
CF_ZONE_API_TOKEN=
CF_ZONE_ID=
AWS_PROFILE=
AWS_HOSTED_ZONE_ID=
DDNS_SUBDOMAIN=myhost
DDNS_PROXY=false

LOG_LEVEL=info

# Promtail logs label, something unique like the server name
LOGS_LABEL=eth-docker
# Path to mount to promtail if needed for extra logs scrape
EXTRA_LOGS_MOUNT_PATH=/dev/null

# Path to mount to node-exporter if needed for --collector.textfile.directory
NODE_EXPORTER_COLLECTOR_MOUNT_PATH=/dev/null

# port 443 and 80 are great defaults
TRAEFIK_WEB_PORT=443
TRAEFIK_WEB_HTTP_PORT=80
TRAEFIK_INSECURE_API=false # Default if not provided
# Set to 0 to allow persistent WebSocket connections (e.g. eth_subscribe); default matches Traefik's built-in
TRAEFIK_READ_TIMEOUT=60s

# Node exporter is direct on host, make sure it doesn't conflict
# If ufw is "in front of" Docker, make sure to allow this traffic
# sudo ufw allow from 172.16.0.0/12 to any port 9199 comment "node-exporter from docker"
# sudo ufw allow from 192.168.0.0/16 to any port 9199 comment "node-exporter from docker"
NODE_EXPORTER_PORT=9199

HOST_IP=
IPV6=false

# Traefik access log: JSON, written to a file in the "accesslog" volume (not stdout), so it is NOT
# collected by promtail/Loki. Rotated daily and kept ACCESSLOG_RETENTION_DAYS days (compressed).
# Headers are dropped except User-Agent and X-Forwarded-For. The JSON-RPC method is in the request
# body and is not logged. Set TRAEFIK_ACCESSLOG=false to disable.
TRAEFIK_ACCESSLOG=true
TRAEFIK_ACCESSLOG_BUFFER=10
ACCESSLOG_RETENTION_DAYS=30

TRAEFIK_TAG=v3.6
DDNS_TAG=v2

# Image versions of the monitoring containers. The defaults follow the latest release; pin them here if a host needs to
# stay on a specific version. NODE_EXPORTER_IMAGE can point at a different registry (for example prom/node-exporter).
PROMTAIL_TAG=latest
OTELCOL_TAG=latest
NODE_EXPORTER_IMAGE=quay.io/prometheus/node-exporter
NODE_EXPORTER_TAG=latest

# traefik-aws
CNAME_LIST=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
TTL=1

# Used by ethd update - please do not adjust
ENV_VERSION=7
